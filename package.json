{
  "name": "growthos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/prisma-generate.mjs",
    "lint": "eslint src",
    "lint:watch": "eslint src --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:push": "node scripts/prisma-db-push.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/prisma-db-push.mjs --force-reset && tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.postgres.prisma"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@prisma/client": "^6.11.0",
    "bcryptjs": "^2.4.3",
    "jose": "^6.0.11",
    "next": "^16.3.8",
    "openai": "^4.104.0",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.3",
    "prisma": "^6.11.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
