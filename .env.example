# GrowthOS Environment Variables
# Copy to .env and update for your environment

# JWT Secret - generate a strong random string for production
JWT_SECRET=your-secret-key-here

# Database
DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_NAME=GrowthOS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# ─── Demo merchant entry (local presentations only) ───────────────
# Clicking "Merchant" on the landing page starts a real, fully
# authenticated session for the seeded demo merchant instead of showing
# the sign-in form.
#
# DEMO_LOGIN_ENABLED is opt-in: anything other than "true" leaves the
# flow disabled. It is additionally hard-disabled whenever
# NODE_ENV=production, so a stray "true" can never enable it on a
# production deploy.
DEMO_LOGIN_ENABLED=false

# The seeded demo merchant to sign in as. The email is not a secret.
DEMO_MERCHANT_EMAIL=arjun@urbanwear.in

# Server-only. NEVER give this a NEXT_PUBLIC_ prefix: that would inline the
# password into the client bundle. Must match the password stored for the demo
# user by prisma/seed.ts, or the request is rejected.
DEMO_MERCHANT_PASSWORD=Password123
