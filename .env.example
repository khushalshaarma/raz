# ============================================================================
# GrowthOS environment variables
#
# Copy to `.env` for local development:   cp .env.example .env
# For Vercel, set these in Project Settings -> Environment Variables
# (mark each as Production and/or Preview). `.env` is gitignored and is never
# deployed.
#
# NO REAL SECRETS BELOW. Every value here is a placeholder.
# ============================================================================

# ─── Required everywhere ─────────────────────────────────────────────────────

# Signs and verifies the session JWT (HS256).
# MUST be >= 32 random characters in production. Startup validation treats the
# development default and any short value as a hard failure.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters

# ─── Database ───────────────────────────────────────────────────────────────
#
# GrowthOS runs on SQLite locally and PostgreSQL in production. The provider is
# chosen from this URL's scheme by scripts/prisma-generate.mjs:
#
#   file:...                     -> prisma/schema.prisma            (SQLite)
#   postgresql://...             -> prisma/schema.postgres.prisma   (PostgreSQL)
#
# A SQLite file CANNOT serve a Vercel deployment: the filesystem is read-only
# outside /tmp and is discarded between invocations, and prisma/*.db is
# gitignored. Production therefore needs a hosted PostgreSQL database (Neon,
# Supabase or Vercel Postgres all work).

# Runtime connection string. In production this SHOULD be the POOLED URL
# (serverless-safe, e.g. Neon appends `-pooler`).
DATABASE_URL="file:./dev.db"

# Direct (unpooled) connection, used by `prisma migrate` and `prisma db push`.
# Migrations cannot run over a pooled connection. Leave blank locally.
DIRECT_URL=""

# ─── App ─────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_NAME=GrowthOS

# Must be the deployed origin in production. Used for links and payment
# callbacks; startup validation flags a localhost value.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel sets this to "production" on deployed builds. You do not need to set it
# manually; it is listed because the demo gate below depends on it.
NODE_ENV=development

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
#
# Keep RAZORPAY_MODE=test unless you deliberately want real money movement.
# Startup validation only reports live mode; it does not switch it.

RAZORPAY_MODE=test

# Only needed when RAZORPAY_MODE=live. Test keys are safe to use.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required in both modes for /api/webhooks/razorpay to accept events.
RAZORPAY_WEBHOOK_SECRET=

# ─── Demo merchant entry ─────────────────────────────────────────────────────
#
# "Merchant" on the landing page starts a REAL, fully authenticated session for
# the seeded demo merchant: the configured password is verified against the
# stored bcrypt hash and a normal JWT is issued as an httpOnly cookie. No
# middleware or guard is bypassed, and the session can only ever be a MERCHANT
# session for one merchant — there is no admin path.
#
# TWO keys are required in production. DEMO_LOGIN_ENABLED alone is inert on a
# deployed build, so a stray or inherited flag can never silently open a public
# site. Setting both is a deliberate act.
#
#   DEMO_LOGIN_ENABLED=false            DEMO_LOGIN_ALLOW_PRODUCTION unset/false  -> disabled
#   DEMO_LOGIN_ENABLED=true             DEMO_LOGIN_ALLOW_PRODUCTION unset/false  -> disabled (404)
#   DEMO_LOGIN_ENABLED=true             DEMO_LOGIN_ALLOW_PRODUCTION=true         -> enabled
#
# Outside production DEMO_LOGIN_ENABLED=true alone is enough.

DEMO_LOGIN_ENABLED=false

# Production-only acknowledgement. Required for the demo shortcut to work on a
# Vercel deployment. Set to false (or remove) to turn demo access off again
# without redeploying the code.
DEMO_LOGIN_ALLOW_PRODUCTION=false

# The seeded demo merchant. The email is not a secret.
DEMO_MERCHANT_EMAIL=arjun@urbanwear.in

# SERVER ONLY. NEVER give this a NEXT_PUBLIC_ prefix: that would inline the
# password into the client bundle and expose it to every visitor.
# Must match the password stored for the demo user by `npm run db:seed`.
DEMO_MERCHANT_PASSWORD=

# ─── AI ──────────────────────────────────────────────────────────────────────

# "deterministic" runs the built-in rule engine and needs no API key, which is
# what you want for a demo. Use "openai" only after setting OPENAI_API_KEY.
AI_PROVIDER=deterministic

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ORG_ID=

AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# ─── Feature flags ───────────────────────────────────────────────────────────
#
# Read in src/lib/config/features.ts. Note the inverted defaults: these are
# enabled unless explicitly set to "false".

FEATURE_AGENTS=true
FEATURE_AUTOPILOT=false
FEATURE_LLM=false
FEATURE_RECONCILIATION=true
FEATURE_WEBHOOKS=true

# ─── Runtime tuning ──────────────────────────────────────────────────────────

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AGENT_TIMEOUT_MS=30000
MAX_RETRY_ATTEMPTS=3

LOG_LEVEL=info

# ─── Seeding ─────────────────────────────────────────────────────────────────

# Pins the seed's generated dates for byte-exact reproducible demo data.
# YYYY-MM-DD. Leave blank to use the seed's default anchor.
SEED_ANCHOR_DATE=
